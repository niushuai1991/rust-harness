{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-worktree.sh\"",
            "timeout": 15,
            "statusMessage": "检查写操作是否位于 worktree..."
          }
        ]
      }
    ]
  }
}
