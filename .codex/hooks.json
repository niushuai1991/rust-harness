{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 -c \"import runpy,subprocess; runpy.run_path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip()+'/.codex/hooks/require_worktree.py',run_name='__main__')\"",
            "timeout": 15,
            "statusMessage": "检查补丁是否位于 worktree..."
          }
        ]
      }
    ]
  }
}
