package rust-harness:plugin@0.1.0;
interface host {
 log: func(message: string);
 read-file: func(path: string) -> result<string, string>;
 write-file: func(path: string, contents: string) -> result<_, string>;
 http-get: func(url: string) -> result<string, string>;
 kv-get: func(key: string) -> option<string>;
 kv-set: func(key: string, value: string) -> result<_, string>;
}
world plugin {
 import host;
 export activate: func() -> result<_, string>;
 export execute: func(name: string, arguments: string) -> result<string, string>;
 export deactivate: func() -> result<_, string>;
}
